{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/agent-config/models-mapping.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profiles"
  ],
  "properties": {
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/profileMapping"
      }
    }
  },
  "definitions": {
    "claudeValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "opencodeValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "variant": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "codexValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "reasoning_effort": {
              "type": "string",
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            }
          }
        }
      ]
    },
    "cursorValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "profileMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "$ref": "#/definitions/claudeValue"
        },
        "opencode": {
          "$ref": "#/definitions/opencodeValue"
        },
        "codex": {
          "$ref": "#/definitions/codexValue"
        },
        "cursor": {
          "$ref": "#/definitions/cursorValue"
        }
      }
    }
  }
}
