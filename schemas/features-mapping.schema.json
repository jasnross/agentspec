{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/agent-config/features-mapping.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "providers"
  ],
  "properties": {
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claude",
        "opencode",
        "codex",
        "cursor"
      ],
      "properties": {
        "claude": { "$ref": "#/definitions/providerFeatures" },
        "opencode": { "$ref": "#/definitions/providerFeatures" },
        "codex": { "$ref": "#/definitions/providerFeatures" },
        "cursor": { "$ref": "#/definitions/providerFeatures" }
      }
    }
  },
  "definitions": {
    "providerFeatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supports_agents": { "type": "boolean" },
        "supports_skills": { "type": "boolean" },
        "supports_subagents": { "type": "boolean" },
        "supports_custom_modes": { "type": "boolean" },
        "supports_tool_allowlist": { "type": "boolean" },
        "supports_temperature": { "type": "boolean" },
        "tools_format": {
          "type": "string",
          "enum": ["csv_list", "boolean_map", "none"]
        }
      }
    }
  }
}
