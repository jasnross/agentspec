{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/agent-config/canonical.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "agent",
        "skill"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "user_invocable": {
      "type": "boolean"
    },
    "agent_invocable": {
      "type": "boolean"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "mode": {
          "type": "string",
          "enum": [
            "subagent",
            "primary"
          ]
        },
        "readonly": {
          "type": "boolean"
        },
        "background": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "edit",
              "grep",
              "glob",
              "bash",
              "webfetch",
              "websearch",
              "task",
              "todowrite",
              "ls"
            ]
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepts_args": {
          "type": "boolean"
        },
        "args_schema": {
          "type": "string"
        },
        "delegate_to": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "opencode",
              "codex",
              "cursor"
            ]
          }
        }
      }
    },
    "provider_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude": {
          "type": "object",
          "additionalProperties": true
        },
        "opencode": {
          "type": "object",
          "additionalProperties": true
        },
        "codex": {
          "type": "object",
          "additionalProperties": true
        },
        "cursor": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
